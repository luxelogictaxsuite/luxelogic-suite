{
  "name": "DocumentRequest",
  "type": "object",
  "properties": {
    "assignment_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "preparer_email": {
      "type": "string",
      "description": "Anchors RLS \u2014 only this preparer (matched by email) and admins can see the record"
    },
    "document_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Requested",
        "Received",
        "Rejected"
      ],
      "default": "Requested"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "client_name",
    "preparer_email",
    "document_name",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.preparer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.preparer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.preparer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}