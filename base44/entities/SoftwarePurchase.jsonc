{
  "name": "SoftwarePurchase",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "software": {
      "type": "string",
      "enum": [
        "TaxSlayer Pro",
        "OLT Pro",
        "Both",
        "70/30 Membership"
      ],
      "default": "TaxSlayer Pro"
    },
    "efin": {
      "type": "string"
    },
    "office_size": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "amount_paid": {
      "type": "number",
      "description": "Dollar amount paid (from Stripe or manually entered)"
    },
    "status": {
      "type": "string",
      "enum": [
        "New",
        "Registration Sent",
        "Registered",
        "Build Started",
        "Completed"
      ],
      "default": "New"
    },
    "paid": {
      "type": "boolean",
      "default": false,
      "description": "Whether payment has been received (via Stripe, manual, or gifted for free)"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "Stripe",
        "Manual",
        "Free"
      ],
      "description": "How payment was recorded \u2014 Stripe webhook, manual mark, or gifted for free"
    }
  },
  "required": [
    "full_name",
    "email",
    "software"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}