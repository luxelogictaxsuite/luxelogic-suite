{
  "name": "SiteSetting",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "e.g. extension_deadline, business_phone, business_email, business_address"
    },
    "label": {
      "type": "string"
    },
    "value": {
      "type": "string"
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}