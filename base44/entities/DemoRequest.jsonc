{
  "name": "DemoRequest",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "software": {
      "type": "string",
      "enum": [
        "TaxSlayer Pro",
        "OLT Pro",
        "Both"
      ],
      "default": "TaxSlayer Pro"
    },
    "efin": {
      "type": "string"
    },
    "office_size": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "New",
        "Contacted",
        "Scheduled"
      ],
      "default": "New"
    }
  },
  "required": [
    "full_name",
    "email"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}