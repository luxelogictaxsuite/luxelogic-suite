{
  "name": "Weekly CE Compliance Reminder",
  "description": "Every Monday at 9am ET, emails every active preparer who is behind on continuing education hours.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * 1",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_ce_reminder",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "remind": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyPreparer",
            "args": {
              "event": "compliance_deadline_all"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Send CE reminders",
            "description": "Email preparers behind on CE hours"
          }
        }
      }
    ]
  }
}