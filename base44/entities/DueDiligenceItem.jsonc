{
  "name": "DueDiligenceItem",
  "type": "object",
  "properties": {
    "assignment_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "preparer_email": {
      "type": "string",
      "description": "Anchors RLS \u2014 only this preparer (matched by email) and admins can see the record"
    },
    "item_label": {
      "type": "string"
    },
    "checked": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "assignment_id",
    "client_name",
    "preparer_email",
    "item_label"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.preparer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.preparer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.preparer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}